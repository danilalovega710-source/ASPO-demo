<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>АСПО.НЕТ — Программное обеспечение для прогнозирования и оптимизации</title>
<style>
  :root {
    --primary: #d90000;
    --dark: #2a2b2d;
    --text: #363636;
    --light: #f4f7f9;
    --white: #ffffff;
    --border: #e9e9e9;
    --accent: #eff3f9;
  }
  
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Arial', sans-serif; }
  
  body { background: var(--white); color: var(--text); line-height: 1.5; }
  a { text-decoration: none; color: inherit; }
  
  /* ================= ШАПКА (как у 2Drill) ================= */
  header {
    background: var(--white);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 1000;
    height: 86px;
    display: flex;
    align-items: center;
  }
  
  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 24px;
    font-weight: 700;
    color: var(--dark);
    letter-spacing: -0.5px;
  }
  
  .logo svg {
    width: 40px;
    height: 40px;
  }
  
  .nav-links {
    display: flex;
    gap: 30px;
    font-size: 14px;
    font-weight: 400;
    color: #000;
  }
  
  .nav-links a:hover {
    color: var(--primary);
  }
  
  .btn-header {
    background: linear-gradient(45deg, #b50202, #ff0303, #ffa8a8);
    color: var(--white);
    padding: 12px 24px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 600;
    transition: transform 0.2s, opacity 0.2s;
  }
  
  .btn-header:hover {
    opacity: 0.9;
    transform: scale(1.02);
  }
  
  /* ================= ГЕРОЙ-БЛОК (как у 2Drill) ================= */
  .hero {
    background: var(--white);
    padding: 60px 0 40px;
    text-align: center;
    max-width: 1000px;
    margin: 0 auto;
  }
  
  .hero h1 {
    font-size: 38px;
    font-weight: 300;
    margin-bottom: 15px;
    color: var(--dark);
  }
  
  .hero h1 strong {
    font-weight: 700;
    color: var(--primary);
  }
  
  .hero p {
    font-size: 16px;
    color: #555;
    max-width: 700px;
    margin: 0 auto 30px;
    opacity: 0.8;
  }
  
  /* ================= КНОПКИ И КАРТОЧКИ ================= */
  .btn-main {
    display: inline-block;
    background: linear-gradient(45deg, #b50202, #ff0303, #ffa8a8);
    color: var(--white);
    padding: 15px 40px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s;
    margin-bottom: 30px;
  }
  
  .btn-main:hover { opacity: 0.9; transform: scale(1.02); }
  
  .section-title {
    text-align: center;
    font-size: 32px;
    font-weight: 500;
    margin-bottom: 40px;
    color: var(--dark);
  }
  
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 25px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .card {
    background: var(--accent);
    padding: 30px;
    border-radius: 20px;
    border: 1px solid var(--border);
    transition: transform 0.3s;
  }
  
  .card:hover { transform: translateY(-5px); }
  .card h3 { font-size: 18px; margin-bottom: 15px; color: var(--dark); }
  .card p { font-size: 14px; color: #666; }
  
  /* ================= ДЕМО-КАЛЬКУЛЯТОР (интеграция) ================= */
  .demo-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    background: var(--accent);
    padding: 30px;
    border-radius: 20px;
    max-width: 900px;
    margin: 0 auto;
    border: 1px solid var(--border);
  }
  
  @media (max-width: 768px) { .demo-container { grid-template-columns: 1fr; } }
  
  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; font-size: 14px; font-weight: 500; margin-bottom: 5px; }
  .form-group input {
    width: 100%; padding: 12px;
    border: 1px solid #dadada; border-radius: 8px;
    font-size: 16px; outline: none;
  }
  .form-group input:focus { border-color: var(--primary); }
  
  .results {
    background: var(--white);
    padding: 25px;
    border-radius: 12px;
    border: 1px solid var(--border);
  }
  
  .metric { display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 14px; }
  .metric .val { font-weight: 700; color: var(--primary); }
  .metric .val.good { color: #27ae60; }
  
  .method-box {
    background: #f8faff; border-left: 4px solid var(--primary);
    padding: 15px; margin-top: 20px; border-radius: 4px;
  }
  .method-box strong { display: block; color: var(--dark); margin-bottom: 5px; }
  
  /* ================= ФУТЕР ================= */
  footer {
    background: var(--accent);
    padding: 40px 20px;
    text-align: center;
    font-size: 14px;
    color: #888;
    border-top: 1px solid var(--border);
  }
  
  @media (max-width: 900px) {
    .nav-links { display: none; }
    .hero h1 { font-size: 28px; }
  }
</style>
</head>
<body>

<!-- ШАПКА (Скопирована структура 2Drill) -->
<header>
  <div class="header-inner">
    <!-- Логотип -->
    <a href="#" class="logo">
      <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <circle cx="50" cy="50" r="45" fill="#d90000"/>
        <path d="M50 15 C50 15, 25 45, 25 65 C25 78, 36 90, 50 90 C64 90, 75 78, 75 65 C75 45, 50 15, 50 15 Z" fill="#fff"/>
        <circle cx="50" cy="65" r="12" fill="#d90000"/>
        <path d="M50 53 L50 77 M38 65 L62 65" stroke="#fff" stroke-width="3"/>
      </svg>
      АСПО<span style="color: var(--primary);">.НЕТ</span>
    </a>
    
    <!-- Меню -->
    <nav class="nav-links">
      <a href="#about">О программе</a>
      <a href="#modules">Модули</a>
      <a href="#characteristics">Характеристики</a>
      <a href="#contacts">Контакты</a>
    </nav>
    
    <!-- Кнопка -->
    <a href="#contacts" class="btn-header">Оставить запрос</a>
  </div>
</header>

<!-- ГЕРОЙ -->
<div class="container">
  <section class="hero">
    <h1>Программный комплекс <br><strong>АСПО.НЕТ</strong></h1>
    <p>Новое комплексное решение для прогнозирования асфальтосмолопарафиновых отложений (АСПО), автоматического подбора методов очистки и расчета экономической эффективности.</p>
    <a href="#demo" class="btn-main">Оставить запрос</a>
  </section>
</div>

<!-- ПРЕИМУЩЕСТВА (структура 2Drill) -->
<section id="about" style="padding: 40px 0; background: var(--white);">
  <h2 class="section-title">С АСПО.НЕТ вы можете</h2>
  <div class="grid-3">
    <div class="card">
      <h3>Прогнозировать отложения</h3>
      <p>Расчет скорости роста АСПО с учетом температуры, давления, вязкости и обводненности. Прогноз глубины начала отложений в НКТ.</p>
    </div>
    <div class="card">
      <h3>Выбирать метод очистки</h3>
      <p>Многокритериальный анализ (эффективность, стоимость, безопасность) для выбора химической, механической или тепловой обработки.</p>
    </div>
    <div class="card">
      <h3>Считать экономику</h3>
      <p>Расчет NPV, ROI, периода окупаемости и потерь от простоя с учетом налогов (НДПИ) и стоимости реагентов на основе ваших данных.</p>
    </div>
  </div>
</section>

<!-- ДЕМОНСТРАЦИЯ (Интерактивный калькулятор) -->
<section id="demo" style="padding: 40px 0; background: #fafafa;">
  <h2 class="section-title">Интерактивная демонстрация</h2>
  <div class="container">
    <div class="demo-container">
      <!-- Форма -->
      <div>
        <h3 style="margin-bottom: 20px;">Входные данные скважины</h3>
        <div class="form-group">
          <label>Дебит нефти, м³/сут (Q)</label>
          <input type="number" id="flowRate" value="45">
        </div>
        <div class="form-group">
          <label>Содержание парафина, % (P)</label>
          <input type="number" id="paraffin" value="9.2">
        </div>
        <div class="form-group">
          <label>Температура нефти, °C (T)</label>
          <input type="number" id="temp" value="30">
        </div>
        <div class="form-group">
          <label>Вязкость нефти, сПз (μ)</label>
          <input type="number" id="viscosity" value="45">
        </div>
        <button class="btn-main" style="width: 100%;" onclick="calculate()">Рассчитать</button>
      </div>

      <!-- Результат -->
      <div class="results" id="resultBox">
        <p style="color: #888; font-style: italic;">Нажмите кнопку «Рассчитать», чтобы получить прогноз...</p>
      </div>
    </div>
  </div>
</section>

<!-- АРХИТЕКТУРА (структура 2Drill) -->
<section id="modules" style="padding: 40px 0; background: var(--accent);">
  <h2 class="section-title">Модули и архитектура</h2>
  <div class="grid-3">
    <div class="card" style="background: white;">
      <h3>Модуль ввода данных</h3>
      <p>Импорт из Excel/CSV, ручной ввод параметров скважины (дебит, обводненность, устьевая температура, давление).</p>
    </div>
    <div class="card" style="background: white;">
      <h3>Модуль теплофизики</h3>
      <p>Распределение температуры по стволу скважины. Определение точки начала кристаллизации парафинов (WAT).</p>
    </div>
    <div class="card" style="background: white;">
      <h3>Модуль прогнозирования</h3>
      <p>Расчет толщины слоя АСПО. Оценка скин-фактора и прогноз снижения дебита во времени.</p>
    </div>
    <div class="card" style="background: white;">
      <h3>Модуль экономики</h3>
      <p>Расчет NPV, ROI, потерь от простоя. Сравнение затрат на обработку и выгоды от дополнительной добычи.</p>
    </div>
    <div class="card" style="background: white;">
      <h3>Модуль отчетности</h3>
      <p>Автоматическая генерация графиков (Matplotlib) и выгрузка рекомендаций в Excel/HTML/PDF.</p>
    </div>
    <div class="card" style="background: white;">
      <h3>Технологический стек</h3>
      <p>Python 3, NumPy, SciPy, Pandas, Matplotlib, Dataclasses, Multithreading (параллельные вычисления парка скважин).</p>
    </div>
  </div>
</section>

<!-- КОНТАКТЫ (как у 2Drill) -->
<section id="contacts" style="padding: 60px 0; text-align: center;">
  <h2 class="section-title">Оставить запрос</h2>
  <div style="max-width: 500px; margin: 0 auto; background: var(--accent); padding: 30px; border-radius: 20px;">
    <p style="margin-bottom: 20px;">Для определения стоимости ПО оставьте заявку, наши специалисты свяжутся с вами</p>
    <input type="text" placeholder="Ваше имя" style="width:100%; padding:12px; margin-bottom:10px; border:1px solid #dadada; border-radius:8px;">
    <input type="tel" placeholder="Телефон" style="width:100%; padding:12px; margin-bottom:10px; border:1px solid #dadada; border-radius:8px;">
    <button class="btn-main" style="width:100%; border:none; cursor:pointer;">Отправить запрос</button>
  </div>
</section>

<footer>
  <p>© АСПО.НЕТ. Продукт разработан в рамках дипломного проекта, 2026</p>
</section>

<script>
  // Логика расчета
  function calculate() {
    const Q = parseFloat(document.getElementById('flowRate').value);
    const P = parseFloat(document.getElementById('paraffin').value);
    const T = parseFloat(document.getElementById('temp').value);
    const mu = parseFloat(document.getElementById('viscosity').value);

    let recommendedMethod = "Химическая обработка";
    let methodScore = 85.0;
    let methodReason = "Оптимальный баланс эффективности (90%) и стоимости.";
    
    if (T > 60 && P > 15) {
        recommendedMethod = "Механическая очистка";
        methodScore = 75.0;
        methodReason = "Высокая температура и концентрация парафина.";
    } else if (P < 5 && Q < 30) {
        recommendedMethod = "Тепловая обработка";
        methodScore = 80.0;
        methodReason = "Низкое содержание парафина и небольшой дебит.";
    }

    const baseNPV = 145000000; 
    const finalNPV = baseNPV + (Q * 100000) - (P * 500000);
    const mrpDays = Math.round(30 + (100 - P) / 2); 
    
    document.getElementById('resultBox').innerHTML = `
      <h3 style="color: var(--primary); margin-bottom: 15px;">Результаты расчета</h3>
      <div class="metric">
        <span>Прогноз МРП (межремонтный период):</span>
        <span class="val good">${mrpDays} дней</span>
      </div>
      <div class="metric">
        <span>Ожидаемый NPV за год:</span>
        <span class="val">${finalNPV.toLocaleString('ru-RU')} руб.</span>
      </div>
      <div class="metric">
        <span>Скин-фактор (прогноз):</span>
        <span class="val" style="color:#e67e22;">${(P * 0.2).toFixed(1)}</span>
      </div>
      
      <div class="method-box">
        <strong>🤖 Рекомендуемый метод:</strong>
        <div style="font-size: 18px; color: #2c3e50; font-weight: bold; margin: 8px 0;">
          ${recommendedMethod}
        </div>
        <div style="font-size: 14px; color: #555;">
          Интегральный балл: <strong>${methodScore} / 100</strong><br>
          <em>${methodReason}</em>
        </div>
      </div>
    `;
  }
</script>

</body>
</html>
