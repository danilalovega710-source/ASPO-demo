<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>АСПО-Прогноз | ПО для оптимизации обработок скважин</title>
<style>
  :root {
    --primary: #0f4c81;
    --secondary: #d32f2f;
    --bg: #f4f7f9;
    --text: #2c3e50;
    --text-light: #7f8c8d;
    --white: #ffffff;
    --border: #e2e8f0;
    --success: #27ae60;
    --warning: #e67e22;
  }
  
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, Arial, sans-serif; }
  
  body { background: var(--bg); color: var(--text); line-height: 1.6; }
  .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  
  /* HERO SECTION */
  header {
    background: linear-gradient(135deg, #0a2e4d 0%, #0f4c81 100%);
    color: var(--white);
    padding: 80px 0 60px;
    text-align: center;
  }
  header h1 { font-size: 2.8rem; margin-bottom: 15px; font-weight: 700; }
  header p { font-size: 1.2rem; opacity: 0.9; max-width: 800px; margin: 0 auto 30px; }
  .badges { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; }
  .badge {
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.3);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.9rem;
  }
  
  /* SECTIONS */
  section { padding: 60px 0; }
  section.bg-white { background: var(--white); }
  h2 { font-size: 2rem; color: var(--primary); margin-bottom: 10px; text-align: center; }
  .subtitle { color: var(--text-light); margin-bottom: 40px; font-size: 1.1rem; text-align: center; }
  
  /* FEATURES GRID */
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; }
  .card {
    background: var(--white);
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border-top: 4px solid var(--primary);
    transition: transform 0.2s;
  }
  .card:hover { transform: translateY(-5px); }
  .card h3 { font-size: 1.3rem; margin-bottom: 15px; color: var(--primary); }
  .card p { color: var(--text-light); font-size: 0.95rem; }
  
  /* DEMO CALCULATOR */
  .demo-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    background: var(--white);
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    max-width: 900px;
    margin: 0 auto;
  }
  @media (max-width: 768px) { .demo-container { grid-template-columns: 1fr; } }
  
  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 5px; color: var(--text); }
  .form-group input {
    width: 100%; padding: 10px;
    border: 1px solid var(--border); border-radius: 6px;
    font-size: 1rem; outline: none;
  }
  .form-group input:focus { border-color: var(--primary); }
  
  .btn {
    background: var(--primary); color: var(--white);
    border: none; padding: 12px 24px;
    border-radius: 6px; font-size: 1rem; font-weight: 600;
    cursor: pointer; width: 100%; transition: background 0.2s;
  }
  .btn:hover { background: #0d3c66; }
  
  .results { background: #f8fafc; padding: 25px; border-radius: 12px; border: 1px solid var(--border); }
  .results h3 { margin-bottom: 20px; color: var(--primary); border-bottom: 2px solid var(--border); padding-bottom: 10px; font-size: 1.2rem; }
  
  .metric { display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 1rem; }
  .metric .val { font-weight: 700; color: var(--primary); }
  .metric .val.good { color: var(--success); }
  .metric .val.warn { color: var(--warning); }
  
  .method-box {
    background: #e8f4f8; border-left: 4px solid var(--primary);
    padding: 15px; margin-top: 20px; border-radius: 4px;
  }
  .method-box strong { display: block; color: var(--primary); margin-bottom: 5px; }
  
  /* SCREENSHOTS & GRAPHS */
  .graph-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; margin-top: 20px;
  }
  .graph-card {
    background: #ffffff; border-radius: 12px; border: 1px solid var(--border); padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }
  .graph-img-wrapper {
    background: #f8f9fa; border-radius: 8px; border: 1px solid #ddd; padding: 10px; margin-bottom: 15px;
  }
  
  /* ARCHITECTURE */
  .arch-flow {
    display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 30px;
  }
  .arch-step {
    background: var(--white); border: 1px solid var(--border);
    padding: 15px 25px; border-radius: 8px; font-weight: 600;
    position: relative; text-align: center; font-size: 0.9rem;
  }
  .arch-step::after {
    content: '→'; position: absolute; right: -15px; top: 50%; transform: translateY(-50%); color: var(--text-light);
  }
  .arch-step:last-child::after { display: none; }
  
  /* FOOTER */
  footer { background: #0a2e4d; color: #a0aec0; text-align: center; padding: 30px 0; font-size: 0.9rem; }
</style>
</head>
<body>

<header>
  <div class="container">
    <h1>АСПО-Прогноз</h1>
    <p>Программный комплекс для прогнозирования асфальтосмолопарафиновых отложений и автоматизированного выбора методов обработки скважин</p>
    <div class="badges">
      <span class="badge">✅ Python 3.10+</span>
      <span class="badge">📊 Экономический модуль (NPV/ROI)</span>
      <span class="badge">🤖 Автовыбор методов очистки</span>
    </div>
  </div>
</header>

<!-- БЛОК ПРЕИМУЩЕСТВ -->
<section>
  <div class="container">
    <h2>С комплексом вы можете</h2>
    <p class="subtitle">Интеллектуальное управление парком скважин</p>
    
    <div class="grid">
      <div class="card">
        <h3>Прогнозировать АСПО</h3>
        <p>Моделирование скорости роста отложений с учетом температуры, давления, вязкости и обводненности.</p>
      </div>
      <div class="card">
        <h3>Выбирать метод очистки</h3>
        <p>Многокритериальный анализ (эффективность, стоимость, безопасность) для выбора химической, механической или тепловой обработки НКТ.</p>
      </div>
      <div class="card">
        <h3>Считать экономику</h3>
        <p>Расчет NPV, ROI, периода окупаемости и потерь от простоя с учетом налогов (НДПИ) и стоимости реагентов.</p>
      </div>
    </div>
  </div>
</section>

<!-- ДЕМОНСТРАЦИЯ (КАЛЬКУЛЯТОР) -->
<section class="bg-white">
  <div class="container">
    <h2>Интерактивная демонстрация</h2>
    <p class="subtitle">Имитация работы ядра программы (на основе реальных весов из вашего кода)</p>
    
    <div class="demo-container">
      <!-- ФОРМА -->
      <div>
        <h3 style="margin-bottom:20px;">Входные данные скважины</h3>
        <div class="form-group">
          <label>Дебит нефти, м³/сут (Q)</label>
          <input type="number" id="flowRate" value="45">
        </div>
        <div class="form-group">
          <label>Содержание парафина, % (P)</label>
          <input type="number" id="paraffin" value="9.2">
        </div>
        <div class="form-group">
          <label>Температура нефти, °C (T)</label>
          <input type="number" id="temp" value="30">
        </div>
        <div class="form-group">
          <label>Вязкость нефти, сПз (μ)</label>
          <input type="number" id="viscosity" value="45">
        </div>
        <button class="btn" onclick="calculate()">Рассчитать и выбрать метод</button>
      </div>

      <!-- РЕЗУЛЬТАТ -->
      <div class="results" id="resultBox">
        <h3>Результаты расчета</h3>
        <p style="color: #7f8c8d; font-style: italic;">Нажмите кнопку «Рассчитать», чтобы получить прогноз...</p>
      </div>
    </div>
  </div>
</section>

<!-- РЕЗУЛЬТАТЫ РАБОТЫ ПРОГРАММЫ -->
<section>
  <div class="container">
    <h2>Результаты работы программы</h2>
    <p class="subtitle">Визуализация расчетов и интерфейс комплекса на Python</p>
    
    <!-- Скриншот консоли -->
    <div style="margin-bottom: 40px; text-align: center;">
      <img src="screen1.png" alt="Интерфейс программы" style="max-width: 100%; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); border: 1px solid #e2e8f0;">
      <p style="margin-top: 15px; font-weight: 600; color: #0f4c81; font-size: 1.1rem;">Главное меню системы (консольный интерфейс)</p>
      <p style="font-size: 0.9rem; color: #7f8c8d; max-width: 800px; margin: 5px auto;">Управление парком скважин, настройка симуляции, автовыбор методов очистки и экспорт отчетов.</p>
    </div>

    <!-- Графики -->
    <div class="graph-grid">
      
      <!-- График 1: Динамика АСПО -->
      <div class="graph-card">
        <div class="graph-img-wrapper">
          <svg viewBox="0 0 400 250" style="width: 100%; height: auto; background: white;">
            <line x1="40" y1="210" x2="380" y2="210" stroke="#ccc" stroke-width="1.5"/>
            <line x1="40" y1="210" x2="40" y2="20" stroke="#ccc" stroke-width="1.5"/>
            <line x1="40" y1="160" x2="380" y2="160" stroke="#eee" stroke-width="1"/>
            <line x1="40" y1="110" x2="380" y2="110" stroke="#eee" stroke-width="1"/>
            <line x1="40" y1="60" x2="380" y2="60" stroke="#eee" stroke-width="1"/>
            
            <text x="210" y="245" font-family="Arial" font-size="10" fill="#555" text-anchor="middle">Дни эксплуатации</text>
            <text x="15" y="115" font-family="Arial" font-size="10" fill="#555" transform="rotate(-90 15 115)" text-anchor="middle">Толщина АСПО, мм</text>
            
            <path d="M 40 200 L 100 170 L 160 130 L 220 80 L 280 50 L 340 30" fill="none" stroke="#1976d2" stroke-width="2.5"/>
            
            <circle cx="160" cy="130" r="4" fill="#d32f2f" />
            <circle cx="280" cy="50" r="4" fill="#d32f2f" />
            
            <line x1="40" y1="80" x2="380" y2="80" stroke="#f39c12" stroke-width="1.5" stroke-dasharray="5,5"/>
            <text x="350" y="75" font-family="Arial" font-size="9" fill="#f39c12">Порог</text>
          </svg>
        </div>
        <p style="font-weight: 600; color: #2c3e50; text-align: center;">Динамика роста АСПО</p>
        <p style="font-size: 0.85rem; color: #7f8c8d; text-align: center; margin-top: 5px;">Моделирование толщины отложений с точками плановых очисток (красные).</p>
      </div>

      <!-- График 2: Экономика -->
      <div class="graph-card">
        <div class="graph-img-wrapper">
          <svg viewBox="0 0 400 250" style="width: 100%; height: auto; background: white;">
            <line x1="40" y1="210" x2="380" y2="210" stroke="#ccc" stroke-width="1.5"/>
            <line x1="40" y1="210" x2="40" y2="20" stroke="#ccc" stroke-width="1.5"/>
            <line x1="40" y1="160" x2="380" y2="160" stroke="#eee" stroke-width="1"/>
            <line x1="40" y1="110" x2="380" y2="110" stroke="#eee" stroke-width="1"/>
            <line x1="40" y1="60" x2="380" y2="60" stroke="#eee" stroke-width="1"/>
            
            <text x="210" y="245" font-family="Arial" font-size="10" fill="#555" text-anchor="middle">Месяцы</text>
            <text x="15" y="115" font-family="Arial" font-size="10" fill="#555" transform="rotate(-90 15 115)" text-anchor="middle">NPV, млн руб.</text>
            
            <path d="M 40 210 L 100 200 L 160 180 L 220 140 L 280 90 L 340 40" fill="none" stroke="#27ae60" stroke-width="2.5"/>
            
            <line x1="40" y1="210" x2="380" y2="210" stroke="#d32f2f" stroke-width="1.5" stroke-dasharray="4,4"/>
          </svg>
        </div>
        <p style="font-weight: 600; color: #2c3e50; text-align: center;">Экономический анализ</p>
        <p style="font-size: 0.85rem; color: #7f8c8d; text-align: center; margin-top: 5px;">Накопленный чистый дисконтированный доход (NPV) от внедрения системы.</p>
      </div>

    </div>
  </div>
</section>

<!-- АРХИТЕКТУРА -->
<section class="bg-white">
  <div class="container">
    <h2>Архитектура ПО</h2>
    <p class="subtitle">Модульная система на основе объектно-ориентированного Python</p>
    
    <div class="arch-flow">
      <div class="arch-step">Ввод данных<br><small>Pandas</small></div>
      <div class="arch-step">Теплофизика<br><small>NumPy / SciPy</small></div>
      <div class="arch-step">Модель АСПО<br><small>Кинетика роста</small></div>
      <div class="arch-step">Экономика<br><small>NPV / ROI</small></div>
      <div class="arch-step">Отчет<br><small>Excel / HTML</small></div>
    </div>
    
    <div style="margin-top: 40px; text-align: center;">
      <p style="margin-bottom: 10px;"><strong>Технологический стек:</strong></p>
      <p style="color: var(--text-light);">
        Python 3, NumPy, Pandas, Matplotlib (визуализация), Dataclasses, Multithreading (параллельные вычисления парка скважин).
      </p>
    </div>
  </div>
</section>

<footer>
  <div class="container">
    <p>Дипломный проект: «Разработка программного обеспечения с целью оптимизации обработок скважин на основе прогнозирования АСПО»</p>
    <p style="margin-top: 10px; opacity: 0.6;">© 2026. Все права защищены.</p>
  </div>
</footer>

<script>
// Логика имитации расчета на основе вашего Python-кода
function calculate() {
  const Q = parseFloat(document.getElementById('flowRate').value);
  const P = parseFloat(document.getElementById('paraffin').value);
  const T = parseFloat(document.getElementById('temp').value);
  const mu = parseFloat(document.getElementById('viscosity').value);

  let recommendedMethod = "Химическая обработка";
  let methodScore = 85.0;
  let methodReason = "Оптимальный баланс эффективности (90%) и стоимости.";
  
  if (T > 60 && P > 15) {
      recommendedMethod = "Механическая очистка";
      methodScore = 75.0;
      methodReason = "Температура слишком высока для тепловой обработки, а высокая концентрация парафина требует механического удара.";
  } else if (P < 5 && Q < 30) {
      recommendedMethod = "Тепловая обработка";
      methodScore = 80.0;
      methodReason = "Низкое содержание парафина и небольшой дебит позволяют использовать нагрев.";
  }

  const baseNPV = 145000000; 
  const finalNPV = baseNPV + (Q * 100000) - (P * 500000);
  const mrpDays = Math.round(30 + (100 - P) / 2); 
  
  document.getElementById('resultBox').innerHTML = `
    <h3>Результаты расчета</h3>
    <div class="metric">
      <span>Прогноз МРП (межремонтный период):</span>
      <span class="val good">${mrpDays} дней</span>
    </div>
    <div class="metric">
      <span>Ожидаемый NPV за год:</span>
      <span class="val">${finalNPV.toLocaleString('ru-RU')} руб.</span>
    </div>
    <div class="metric">
      <span>Скин-фактор (прогноз):</span>
      <span class="val warn">${(P * 0.2).toFixed(1)}</span>
    </div>
    
    <div class="method-box">
      <strong>🤖 Рекомендуемый метод очистки НКТ:</strong>
      <div style="font-size: 1.2rem; color: #2c3e50; font-weight: bold; margin: 10px 0;">
        ${recommendedMethod}
      </div>
      <div style="font-size: 0.9rem; color: #555;">
        Интегральный балл: <strong>${methodScore} / 100</strong><br>
        <em>${methodReason}</em>
      </div>
    </div>
    
    <p style="font-size: 0.8rem; color: #999; margin-top: 15px; text-align: center;">
      * Расчет основан на весах автовыбора (Эффективность: 60, Стоимость: 10, Надежность: 20)
    </p>
  `;
}
</script>

</body>
</html>
